# Keep the shared engine outside the game workspace; never install into it.
set(JSD_GAME_ENGINE_DIR "" CACHE PATH "Path to the JSD 3d-engine source directory")
if(NOT JSD_GAME_ENGINE_DIR AND DEFINED ENV{JSD_GAME_ENGINE_DIR})
    set(JSD_GAME_ENGINE_DIR "$ENV{JSD_GAME_ENGINE_DIR}" CACHE PATH "JSD engine source" FORCE)
endif()
if(NOT JSD_GAME_ENGINE_DIR)
    message(FATAL_ERROR "Supply the external engine: ./build.sh /path/to/3d-engine (or -DJSD_GAME_ENGINE_DIR=/path/to/3d-engine)")
endif()
get_filename_component(JSD_GAME_ENGINE_DIR "${JSD_GAME_ENGINE_DIR}" REALPATH BASE_DIR "${CMAKE_SOURCE_DIR}")
if(NOT EXISTS "${JSD_GAME_ENGINE_DIR}/JSD_PROJECT.json" OR NOT EXISTS "${JSD_GAME_ENGINE_DIR}/include/jsd/engine.hpp")
    message(FATAL_ERROR "JSD_GAME_ENGINE_DIR must point to the 3d-engine source root, containing JSD_PROJECT.json and include/jsd/engine.hpp")
endif()
file(READ "${JSD_GAME_ENGINE_DIR}/JSD_PROJECT.json" engine_identity)
string(JSON engine_id GET "${engine_identity}" project_id)
string(JSON engine_version GET "${engine_identity}" version)
string(JSON engine_kind GET "${engine_identity}" kind)
if(NOT engine_id STREQUAL "jsd.engine" OR NOT engine_kind STREQUAL "source" OR NOT engine_version VERSION_EQUAL "0.5.16")
    message(FATAL_ERROR "Lunar Colony 0.67.0 requires JSD engine source 0.5.16; selected ${engine_id} ${engine_version} (${engine_kind})")
endif()
if(DEFINED GAME_CONFIGURED_ENGINE_DIR AND NOT GAME_CONFIGURED_ENGINE_DIR STREQUAL JSD_GAME_ENGINE_DIR)
    message(FATAL_ERROR "This build directory belongs to engine ${GAME_CONFIGURED_ENGINE_DIR}. Remove the game's platform build directory before selecting another engine.")
endif()
set(GAME_CONFIGURED_ENGINE_DIR "${JSD_GAME_ENGINE_DIR}" CACHE INTERNAL "Engine identity for this build")
foreach(option JSD_BUILD_TESTS JSD_BUILD_EXAMPLES JSD_BUILD_SHOWCASE JSD_BUILD_PROJECT_PLAYER)
    set(${option} OFF CACHE BOOL "Only build the engine required by Lunar Colony" FORCE)
endforeach()
add_subdirectory("${JSD_GAME_ENGINE_DIR}" "${CMAKE_BINARY_DIR}/external-jsd" EXCLUDE_FROM_ALL)
message(STATUS "Lunar Colony uses JSD ${engine_version}: ${JSD_GAME_ENGINE_DIR}")
