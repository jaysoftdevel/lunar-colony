{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "GAME_BIN_DIR": "${sourceDir}/build/linux/bin"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base",
      "displayName": "Linux x64 - SDL/JSD OpenGL - Release",
      "binaryDir": "${sourceDir}/build/linux/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GAME_BUILD_NAVIGATION_TESTS": "ON",
        "GAME_DEBUG_FEATURES": "OFF"
      }
    },
    {
      "name": "linux-debug-features",
      "inherits": "linux-base",
      "displayName": "Linux x64 - Release with debug gameplay features",
      "binaryDir": "${sourceDir}/build/linux/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GAME_BUILD_NAVIGATION_TESTS": "ON",
        "GAME_DEBUG_FEATURES": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 - SDL/JSD OpenGL",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "GAME_BUILD_NAVIGATION_TESTS": "ON",
        "GAME_DEBUG_FEATURES": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug-features",
      "inherits": "windows-x64",
      "displayName": "Windows x64 - Release with debug gameplay features",
      "cacheVariables": {
        "GAME_DEBUG_FEATURES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-features",
      "configurePreset": "linux-debug-features",
      "configuration": "Release"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-debug-features",
      "configurePreset": "windows-debug-features",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug-features",
      "configurePreset": "linux-debug-features",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug-features",
      "configurePreset": "windows-debug-features",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
